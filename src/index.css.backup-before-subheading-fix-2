@tailwind base;
@tailwind components;
@tailwind utilities;

html {
  scroll-behavior: smooth;
}

body {
  font-family: "Archivo", ui-sans-serif, system-ui, sans-serif;
  overflow-x: clip;
  background-color: hsl(var(--background));
  color: hsl(var(--foreground));
}

::selection {
  background: hsl(var(--wind-blue));
  color: hsl(var(--wind-white));
}

@layer base {
  :root {
    --wind-blue: 236 91% 36%;
    --wind-black: 0 0% 0%;
    --wind-orange: 0 90% 25%; /* #780606 */
    --wind-white: 0 0% 100%;
    --wind-pale: 0 0% 100%;
    --background: 0 0% 100%;
    --foreground: 0 0% 0%;
    --card: 0 0% 100%;
    --card-foreground: 0 0% 0%;
    --popover: 0 0% 100%;
    --popover-foreground: 0 0% 0%;
    --primary: 0 0% 0%;
    --primary-foreground: 0 0% 100%;
    --secondary: 236 91% 36%;
    --secondary-foreground: 0 0% 100%;
    --muted: 0 0% 96%;
    --muted-foreground: 0 0% 28%;
    --accent: 236 91% 36%;
    --accent-foreground: 0 0% 100%;
    --destructive: 0 84.2% 60.2%;
    --destructive-foreground: 0 0% 100%;
    --border: 0 0% 0%;
    --input: 0 0% 0%;
    --ring: 236 91% 36%;
    --radius: 0rem;
    --sidebar-background: 0 0% 100%;
    --sidebar-foreground: 0 0% 0%;
    --sidebar-primary: 0 0% 0%;
    --sidebar-primary-foreground: 0 0% 100%;
    --sidebar-accent: 0 0% 96%;
    --sidebar-accent-foreground: 0 0% 0%;
    --sidebar-border: 0 0% 0%;
    --sidebar-ring: 236 91% 36%;
  }
}

.wind-outline {
  color: transparent;
  -webkit-text-stroke: 1.5px hsl(var(--wind-orange));
}

.marker-underline {
  background-image: linear-gradient(to right, hsl(var(--foreground)) 0%, hsl(var(--foreground)) 100%);
  background-repeat: no-repeat;
  background-size: 100% 0.14em;
  background-position: 0 92%;
}

@keyframes wind-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

.animate-wind-marquee { animation: wind-marquee 26s linear infinite; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .animate-wind-marquee { animation: none; }
}

/* Case-study artwork: show the full source image rather than cropping it into a fixed ratio. */
.case-study-image { width: 100%; height: auto; max-height: 75vh; object-fit: contain; display: block; }

/* Project-card supporting metadata only. Does not affect project titles. */
.project-card-subheading {
  font-size: clamp(10px, 0.7vw, 13px);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #ffffff;
}
